# ============================================================
#  코니처 — Apache 설정
#  http 접속을 https 로 넘기고, www 주소를 대표 주소로 통일합니다.
#
#  ⚠️ 절대 SSL 인증서 설치가 완료되기 전에 올리지 마세요.
#     https 가 아직 안 되는 상태에서 이 파일을 올리면
#     사이트 전체가 접속 불가가 됩니다.
#
#  업로드 위치: index.html 과 같은 최상위 폴더
#  파일명은 점으로 시작하는 .htaccess 입니다 (확장자 없음)
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 1) http → https 강제 ──────────────────────────────
  # X-Forwarded-Proto 조건은 프록시 뒤에서 무한 리다이렉트가
  # 생기는 것을 막기 위한 안전장치입니다. 지우지 마세요.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── 2) www 제거 (대표 주소 통일) ───────────────────────
  # canonical 이 www 없는 주소이므로 여기에 맞춥니다.
  # www 를 대표로 쓰시려면 이 블록을 지우세요.
  RewriteCond %{HTTP_HOST} ^www\.koniture-g-south\.co\.kr$ [NC]
  RewriteRule ^ https://koniture-g-south.co.kr%{REQUEST_URI} [R=301,L]
</IfModule>

# ── 브라우저 캐시 (선택) ────────────────────────────────
# 이미지·CSS 를 재방문 시 다시 받지 않게 해 속도를 올립니다.
#
# ⚠️ 사진을 "같은 파일명"으로 교체하면, 이미 방문했던 브라우저는
#    최대 1달간 옛 사진을 계속 보여줍니다. (2026-09 시스템행거 사진이 남아 보인 원인)
#    사진을 교체할 때는 index.html · sitemap.xml 의 사진 주소 뒤 버전을 바꿔주세요.
#      예) 7.jpg?v=20260916  →  7.jpg?v=20261001
#    또는 새 파일명(예: 11.jpg)으로 올리면 됩니다.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
</IfModule>
